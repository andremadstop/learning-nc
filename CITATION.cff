    website: "https://souverain-systems.de"
version: 5.6.0
date-released: 2026-10-09
repository-code: "https://github.com/andremadstop/learning-nc"
url: "https://apps.nextcloud.com/apps/learning"
license: AGPL-3.0
keywords:
  - Nextcloud
  - spaced repetition
  - Leitner
  - FSRS
  - e-learning
  - certificates
  - self-hosted
