# Ralph Configuration — Learning-NC
# Nextcloud Spaced Repetition App

PROJECT_NAME="learning-nc"
PROJECT_TYPE="javascript"
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=15
CLAUDE_OUTPUT_FORMAT="json"

# Tools Ralph darf nutzen
ALLOWED_TOOLS="Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch,Task,TodoWrite"

# Session
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task Sources
TASK_SOURCES="local"

# Circuit Breaker
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=3
CB_OUTPUT_DECLINE_THRESHOLD=5
CB_COOLDOWN_MINUTES=10
CB_AUTO_RESET=true

# Advanced
RALPH_VERBOSE=false
