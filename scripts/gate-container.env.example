# Optional overrides for scripts/gate-container.sh — export these in your shell.
# No secrets here. Defaults are pinned in the script; change only to test another stack.

# Image with the Nextcloud 3rdparty tree at /usr/src/nextcloud/3rdparty (PHPStan scans it).
# GATE_IMAGE=nextcloud:33@sha256:df735d59202b74546ca4f935ec860d8397995a6e4e353926c4876547f6c6c4a5

# Composer release downloaded into the container, verified by SHA-256
# (value from https://getcomposer.org/download/<version>/composer.phar.sha256sum).
# GATE_COMPOSER_VERSION=2.10.3
# GATE_COMPOSER_SHA256=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6
