          { "option_index": 0, "letter": "A", "verdict": "wrong", "why": "Blue bananas exist only as a cultivar name.", "misconception": "Taking a name literally" },
          { "option_index": 1, "letter": "B", "verdict": "correct", "why": "The peel turns yellow when ripe." },
          { "option_index": 2, "letter": "C", "verdict": "wrong", "why": "Purple is a plum.", "misconception": "Mixing up fruits" }
        ]
      },
      "is_correct": [false, true, false],
      "expected": {
        "hint": "Think of the fruit bowl.",
        "background_fact": "Bananas turn yellow as chlorophyll breaks down.",
        "key_takeaway": "Ripe means yellow.",
        "option_feedback": [
          { "position": 0, "why": "Blue bananas exist only as a cultivar name.", "misconception": "Taking a name literally" },
          { "position": 1, "why": "The peel turns yellow when ripe.", "misconception": null },
          { "position": 2, "why": "Purple is a plum.", "misconception": "Mixing up fruits" }
        ],
        "dropped_languages": [],
        "verdict_mismatches": 0,
        "unmatched": 0
      }
    },
    {
