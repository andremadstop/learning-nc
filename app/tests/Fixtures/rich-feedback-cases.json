        "unmatched": 0
      }
    },
    {
      "name": "without lang: en before de; feedback on the answer objects; a contradicting verdict is counted",
      "item": {
        "text": "Water boils at sea level at …",
        "answers": [
          { "text": "100 °C", "is_correct": true, "why": "At 1013 hPa." },
