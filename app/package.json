{
  "name": "learning",
  "version": "0.1.0",
  "description": "Nextcloud Learning App with Spaced Repetition",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "postbuild": "node -e \"const fs=require('fs'); const js=fs.readFileSync('js/learning.js','utf8'); const checks={showVirtuProfDock:1,'app-shell':1,CourseDetail:1}; for (const [key,min] of Object.entries(checks)) { const count=(js.match(new RegExp(key,'g'))||[]).length; if (count < min) { console.error('BUILD CHECK FAILED: ' + key + ' expected >=' + min + ' got ' + count); process.exit(1); } } console.log('Build checks passed')\"",
    "watch": "webpack --mode development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "playwright test --project=chromium",
    "lint": "eslint --ext .js,.vue src/ tests/",
    "lint:fix": "eslint --ext .js,.vue --fix src/ tests/"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^5.3.7",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^8.20.0",
    "canvas-confetti": "^1.9.4",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "linkifyjs": "^4.3.2",
    "pinia": "^2.3.1",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.53.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.8.8",
    "style-loader": "^4.0.0",
    "vitest": "^4.1.0",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
