{
  "name": "learning",
  "version": "0.1.0",
  "description": "Nextcloud Learning App with Spaced Repetition",
  "scripts": {
    "dev": "node ./build-vite.mjs --watch",
    "build": "node ./build-vite.mjs",
    "postbuild": "node -e \"const fs=require('fs'); const js=fs.readFileSync('js/learning.js','utf8'); const checks={showVirtuProfDock:1,'app-shell':1,CourseDetail:1}; for (const [key,min] of Object.entries(checks)) { const count=(js.match(new RegExp(key,'g'))||[]).length; if (count < min) { console.error('BUILD CHECK FAILED: ' + key + ' expected >=' + min + ' got ' + count); process.exit(1); } } console.log('Build checks passed')\"",
    "watch": "node ./build-vite.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "playwright test --project=chromium",
    "lint": "eslint --ext .js,.vue src/ tests/",
    "lint:fix": "eslint --ext .js,.vue --fix src/ tests/"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.6.0",
    "canvas-confetti": "^1.9.4",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "linkifyjs": "^4.3.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.32",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.8.8",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
