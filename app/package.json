{
  "name": "learning",
  "version": "0.1.0",
  "description": "Nextcloud Learning App with Spaced Repetition",
  "scripts": {
    "dev": "node ./build-vite.mjs --watch",
    "build": "node ./build-vite.mjs",
    "postbuild": "node ./build-check.mjs",
    "watch": "node ./build-vite.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:print": "playwright test -c tests/print/playwright.config.cjs --project chromium",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "test:pdf": "bash ../scripts/pdf-gate.sh"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^8.0.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.6.0",
    "canvas-confetti": "^1.9.4",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "modern-screenshot": "4.7.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/compiler-sfc": "^3.5.46",
    "axe-core": "4.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-check": "4.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "31.0.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
