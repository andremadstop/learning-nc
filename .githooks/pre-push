#!/bin/bash
# Pre-push Quality Gate: Security + ESLint + Vitest + PHPStan + PHPUnit + SQL-Spalten + i18n
# + Umlaute + Forbidden Names + Repo-Hygiene.
#
# Geprueft wird, was gepusht wird: fuer jeden lokalen Commit aus stdin
# (<local-ref> <local-sha> <remote-ref> <remote-sha>) ein sauberer Snapshot dieses Commits.
# Jedes Gate laeuft gegen den Snapshot, keins gegen die Arbeitskopie — ein uncommitteter Fix
# darf einen kaputten Commit nicht gruen aussehen lassen. Ohne stdin (direkt aufgerufen) gilt
# HEAD. Loeschungen (sha 000…) haben keinen Inhalt und werden uebersprungen.
# PHP-Gates laufen lokal in Wegwerf-Containern (scripts/gate-container.sh, scripts/schema-dump.sh).
# Bis 2026-09-25 liefen sie per ssh auf relais/devcloud und meldeten SKIP, wenn der Host weg
# war. devcloud existiert nicht mehr; ein Gate, das nicht laufen kann, blockiert jetzt.
set -uo pipefail   # kein -e: FAILED sammelt alle Gates, damit ein Lauf alle Fehler zeigt

ROOT_DIR="$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=lib-snapshot.sh
. "$ROOT_DIR/.githooks/lib-snapshot.sh"

FAILED=0
PUSH_SHAS=""
if [ ! -t 0 ]; then
    while read -r _local_ref local_sha _remote_ref _remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        PUSH_SHAS="$PUSH_SHAS $local_sha"
    done
fi
if [ -z "$PUSH_SHAS" ]; then
    PUSH_SHAS="$(git rev-parse HEAD)" || exit 1
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/learning-prepush.XXXXXX")" || exit 1
trap 'rm -r -- "$TMP"' EXIT

echo -e "${GATE_YELLOW}=== Pre-Push Quality Gate ===${GATE_NC}"

for SHA in $(echo "$PUSH_SHAS" | tr ' ' '\n' | sort -u); do
    SNAP="$TMP/$SHA"
    echo -e "${GATE_YELLOW}--- Commit ${SHA:0:10} ---${GATE_NC}"
    if ! make_snapshot "$SNAP" --ref "$SHA"; then
        gate_fail "Snapshot von $SHA nicht erstellbar — Gates nicht gelaufen"
        FAILED=1
        continue
    fi

    gate_security "$SNAP"        || FAILED=1
    gate_eslint "$SNAP"          || FAILED=1
    gate_vitest "$SNAP"          || FAILED=1
    gate_php "$SNAP" --ref "$SHA" || FAILED=1

    # SQL-Spalten gegen das Schema einer frischen Installation dieses Commits.
    # Fand am 22.08.2026 vier stille Totalausfaelle auf einmal (c.name auf learning_courses,
    # ua.user_id auf learning_user_answers) — fuer PHPStan unsichtbar, der Defekt steckt im String.
    echo -n "SQL-Spalten... "
    # Beide Skripte aus dem Snapshot (nicht der Arbeitskopie), wie gate_php.
    if [ ! -x "$SNAP/scripts/schema-dump.sh" ] || [ ! -f "$SNAP/scripts/check-sql-columns.py" ]; then
        gate_fail "Commit enthaelt schema-dump.sh/check-sql-columns.py nicht"
        FAILED=1
    elif ! DUMP_OUT=$(GATE_GIT_ROOT="$ROOT_DIR" "$SNAP/scripts/schema-dump.sh" "$TMP/schema-$SHA.txt" --ref "$SHA" 2>&1); then
        gate_fail "Schema-Dump fehlgeschlagen"
        echo "$DUMP_OUT" | tail -8
        FAILED=1
    elif SQLCOL_OUT=$(SCHEMA_FILE="$TMP/schema-$SHA.txt" APP_LIB="$SNAP/app/lib" python3 "$SNAP/scripts/check-sql-columns.py" 2>&1); then
        gate_ok "$(echo "$SQLCOL_OUT" | tail -1)"
    else
        gate_fail
        echo "$SQLCOL_OUT" | head -12
        FAILED=1
    fi

    # Umlaut-Check: ae/ue/oe in deutschen UI-Texten erkennen (Warnung, kein Blocker)
    echo -n "Umlaut-Check... "
    UMLAUT_HITS=$(grep -rn --include="*.vue" --include="*.js" -P "(?<![a-zA-Z])(fuer|ueber|Uebung|Aenderung|Erklaer|Guelt|hinzufueg|Loeschen|Pruef|zurueck|verfueg|Groess|hoech|moeg|oeffen|Rueck|Ausfuehr|Einfueg|Aehnl|Uebersetz|aerger|aendern|Aerger|aergern|Aenderungen|Einfuehrung|Eroeffnung|ueberpruef|Ueberpruef|Schaetzen|schaetzen|waehlen|Waehlen|erhoeh|Erhoeh|gewaehlt|Gewaehlt|Zugaeng|zugaeng|vollstaendig|Vollstaendig|saemtlich|Saemtlich|unterstuetz|Unterstuetz|aeusser|Aeusser|spaeter|Spaeter|naechst|Naechst|haeufig|Haeufig)(?![a-zA-Z])" "$SNAP/app/src/" 2>/dev/null | grep -v '\.test\.' || true)
    if [ -n "$UMLAUT_HITS" ]; then
        echo -e "${GATE_YELLOW}WARN — $(echo "$UMLAUT_HITS" | wc -l) Stellen mit ae/ue/oe statt Umlauten:${GATE_NC}"
        echo "${UMLAUT_HITS//$SNAP\//}" | head -5
    else
        gate_ok
    fi

    # Forbidden Names (LEGAL-02) — Einstein/Hawking/Tyson/Neil deGrasse/StarTalk/Cosmos.
    gate_forbidden_names "$SNAP" || FAILED=1

    # i18n: Key-Parity, .js==.json, Platzhalter, Quelle->Katalog, VirtuProf-Katalog.
    gate_i18n "$SNAP"            || FAILED=1

    # Repo-Hygiene — interne Arbeitsdocs duerfen nicht im gepushten Commit sein (nur die
    # Whitelist LEGAL/STATE/ROADMAP/REQUIREMENTS/PROJECT + sensitivity-review). Geprueft wird
    # der Baum des Commits, nicht der Index.
    echo -n "Repo-Hygiene... "
    if ! TREE_FILES=$(git ls-tree -r --name-only "$SHA"); then
        gate_fail "git ls-tree $SHA fehlgeschlagen"
        FAILED=1
    else
        BAD_TRACKED=$(echo "$TREE_FILES" | grep -E '^HANDOFF\.md$|^\.planning/' \
            | grep -vE '^\.planning/(LEGAL|STATE|ROADMAP|REQUIREMENTS|PROJECT)\.md$|^\.planning/sensitivity-review/' || true)
        if [ -n "$BAD_TRACKED" ]; then
            gate_fail "interne Arbeitsdocs getrackt (gehoeren nicht ins Public-Repo):"
            echo "$BAD_TRACKED" | head -10
            echo -e "${GATE_YELLOW}  → 'git rm --cached <datei>' (bleibt lokal). Whitelist: LEGAL/STATE/ROADMAP/REQUIREMENTS/PROJECT + sensitivity-review/${GATE_NC}"
            FAILED=1
        else
            gate_ok
        fi
    fi
done

echo ""
if [ $FAILED -ne 0 ]; then
    echo -e "${GATE_RED}=== PUSH BLOCKIERT — Fehler oben beheben ===${GATE_NC}"
    exit 1
fi
echo -e "${GATE_GREEN}=== Alle Gates bestanden ===${GATE_NC}"
