#!/bin/bash
# Pre-push Quality Gate: ESLint + Vitest + PHPStan + Security
# Alle Gates muessen bestehen bevor gepusht wird.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

FAILED=0
SKIPPED=0
ROOT_DIR="$(git rev-parse --show-toplevel)"
APP_DIR="$ROOT_DIR/app"

echo -e "${YELLOW}=== Pre-Push Quality Gate ===${NC}"

# 1. Security: Keine hardcoded API-Keys oder Passwoerter
echo -n "Security scan... "
SECRETS=$(grep -rn 'api_key.*=.*["'"'"']sk-\|password\s*=\s*["'"'"'][A-Za-z0-9]' --include="*.php" --include="*.js" --include="*.vue" "$APP_DIR/lib/" "$APP_DIR/src/" 2>/dev/null | grep -v 'getenv\|config\|Config\|IConfig\|test\|example\|\.env\|password_hash\|passwordField\|password_confirm\|password_reset\|PASSWORD' || true)
if [ -n "$SECRETS" ]; then
    echo -e "${RED}FAIL — Moeglicherweise hardcoded Secrets:${NC}"
    echo "$SECRETS"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 2. ESLint (0 errors Pflicht)
echo -n "ESLint... "
cd "$APP_DIR"
if npx eslint --ext .js,.vue src/ --quiet 2>/dev/null; then
    echo -e "${GREEN}OK (0 errors)${NC}"
else
    echo -e "${RED}FAIL${NC}"
    npx eslint --ext .js,.vue src/ --quiet 2>/dev/null | head -10
    FAILED=1
fi

# 3. Vitest (alle JS Unit-Tests)
echo -n "Vitest... "
# Exitcode entscheidet, nicht der Text: 'Tests 1 failed | 1220 passed' enthaelt "passed" und
# wurde dadurch als OK gewertet — derselbe Fehler, der das PHPUnit-Gate wertlos machte.
VITEST_OUT=$(npm run test 2>&1)
VITEST_RC=$?
if [ $VITEST_RC -eq 0 ]; then
    PASSED=$(echo "$VITEST_OUT" | grep "Tests" | grep -o "[0-9]* passed")
    echo -e "${GREEN}OK ($PASSED)${NC}"
else
    echo -e "${RED}FAIL (exit $VITEST_RC)${NC}"
    echo "$VITEST_OUT" | tail -8
    FAILED=1
fi
cd "$ROOT_DIR"

# 4. PHPStan (remote, non-blocking)
echo -n "PHPStan... "
# Exitcode SEPARAT erfassen: ein '|| echo UNREACHABLE' verschluckt jeden Nicht-null-Exit und
# macht aus einem echten Fehlschlag ein SKIP. Nur SSH-255 heisst "Host nicht erreichbar";
# alles andere kommt aus dem Container und muss blockieren.
PHPSTAN_OUT=$(ssh -o ConnectTimeout=5 relais 'docker exec -w /var/www/html/custom_apps/learning devcloud-app php vendor/bin/phpstan analyse --no-progress 2>&1')
PHPSTAN_RC=$?
if [ $PHPSTAN_RC -eq 255 ]; then
    echo -e "${YELLOW}SKIP (relais nicht erreichbar)${NC}"
    SKIPPED=$((SKIPPED + 1))
elif [ $PHPSTAN_RC -eq 0 ] && echo "$PHPSTAN_OUT" | grep -q "No errors"; then
    echo -e "${GREEN}OK (Level 5)${NC}"
else
    echo -e "${RED}FAIL (exit $PHPSTAN_RC)${NC}"
    echo "$PHPSTAN_OUT" | head -10
    FAILED=1
fi

# 4b. PHPUnit (remote, non-blocking wenn relais weg)
# Ohne dieses Gate laufen die PHP-Tests in keinem Pflichtlauf — genau deshalb konnte Codeberg #2
# (AiController, alle AI-Endpoints 500) fuenf Monate lang durchrutschen. Achtung, gleiche
# Einschraenkung wie bei PHPStan oben: geprueft wird der Stand IM CONTAINER, nicht der Working
# Tree. Nach PHP-Aenderungen also erst deployen, dann pushen.
echo -n "PHPUnit... "
PHPUNIT_OUT=$(ssh -o ConnectTimeout=5 relais 'docker exec -w /var/www/html/custom_apps/learning devcloud-app php vendor/bin/phpunit 2>&1')
PHPUNIT_RC=$?
# Exitcode ZUERST, Text nur zur Anzeige. Die erste Fassung dieses Gates haengte
# '|| echo UNREACHABLE' an und meldete deshalb bei Exit 1 (= fehlgeschlagene Tests) ein SKIP —
# es schuetzte genau vor dem Fall nicht, fuer den es gebaut wurde.
# Ausserdem: Erfolg NICHT an "OK (" erkennen, bei Deprecations/Skips schreibt PHPUnit
# "OK, but there were issues!" und liefert trotzdem Exit 0.
if [ $PHPUNIT_RC -eq 255 ]; then
    echo -e "${YELLOW}SKIP (relais nicht erreichbar)${NC}"
    SKIPPED=$((SKIPPED + 1))
elif [ $PHPUNIT_RC -ne 0 ]; then
    echo -e "${RED}FAIL (exit $PHPUNIT_RC)${NC}"
    echo "$PHPUNIT_OUT" | grep -E "^[0-9]+\)|^(FAILURES|ERRORS)!|^Tests:" | head -10
    FAILED=1
elif echo "$PHPUNIT_OUT" | grep -qE "^Tests: [0-9]+"; then
    echo -e "${GREEN}OK ($(echo "$PHPUNIT_OUT" | grep -oE "^Tests: [0-9]+" | grep -oE "[0-9]+") Tests)${NC}"
else
    echo -e "${RED}FAIL (Exit 0, aber keine Tests gelaufen)${NC}"
    echo "$PHPUNIT_OUT" | tail -5
    FAILED=1
fi

# 4c. SQL-Spalten gegen das echte Schema (remote, SKIP wenn DB nicht erreichbar)
# Fand am 22.08.2026 vier stille Totalausfaelle auf einmal: c.name auf learning_courses (zweimal)
# und ua.user_id auf learning_user_answers (zweimal). Alle vier sind fuer PHPStan unsichtbar, weil
# der Defekt im String steckt, und alle vier sassen hinter einem catch(Throwable).
echo -n "SQL-Spalten... "
SQLCOL_OUT=$(python3 "$ROOT_DIR/scripts/check-sql-columns.py" 2>&1)
SQLCOL_RC=$?
if [ $SQLCOL_RC -eq 2 ]; then
    echo -e "${YELLOW}SKIP (DB-Schema nicht erreichbar)${NC}"
    SKIPPED=$((SKIPPED + 1))
elif [ $SQLCOL_RC -ne 0 ]; then
    echo -e "${RED}FAIL${NC}"
    echo "$SQLCOL_OUT" | head -12
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 5. Umlaut-Check: ae/ue/oe in deutschen UI-Texten erkennen
echo -n "Umlaut-Check... "
UMLAUT_HITS=$(grep -rn --include="*.vue" --include="*.js" -P "(?<![a-zA-Z])(fuer|ueber|Uebung|Aenderung|Erklaer|Guelt|hinzufueg|Loeschen|Pruef|zurueck|verfueg|Groess|hoech|moeg|oeffen|Rueck|Ausfuehr|Einfueg|Aehnl|Uebersetz|aerger|aendern|Aerger|aergern|Aenderungen|Einfuehrung|Eroeffnung|ueberpruef|Ueberpruef|Schaetzen|schaetzen|waehlen|Waehlen|erhoeh|Erhoeh|gewaehlt|Gewaehlt|Zugaeng|zugaeng|vollstaendig|Vollstaendig|saemtlich|Saemtlich|unterstuetz|Unterstuetz|aeusser|Aeusser|spaeter|Spaeter|naechst|Naechst|haeufig|Haeufig)(?![a-zA-Z])" "$APP_DIR/src/" 2>/dev/null | grep -v '\.test\.' | grep -v 'node_modules' || true)
if [ -n "$UMLAUT_HITS" ]; then
    COUNT=$(echo "$UMLAUT_HITS" | wc -l)
    echo -e "${YELLOW}WARN — $COUNT Stellen mit ae/ue/oe statt Umlauten:${NC}"
    echo "$UMLAUT_HITS" | head -5
    # Warnung, kein Blocker (noch)
else
    echo -e "${GREEN}OK${NC}"
fi

# 6. Forbidden Names (LEGAL-02) — blocks Einstein/Hawking/Tyson/Neil deGrasse/
#    StarTalk + Cosmos-as-show-title in app/src, app/l10n, CHANGELOG, info.xml.
echo -n "Forbidden names... "
if "$ROOT_DIR/scripts/check-forbidden-names.sh" >/dev/null 2>&1; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    "$ROOT_DIR/scripts/check-forbidden-names.sh" | head -20
    FAILED=1
fi

# 7. i18n Key-Parity (I18N-02) — DE/EN/FR/RU/AR must share key-set.
echo -n "i18n key-parity... "
if PARITY_OUT=$(bash "$ROOT_DIR/scripts/check-i18n-parity.sh" 2>&1); then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL — i18n key-parity check failed (fix l10n drift before pushing):${NC}"
    echo "$PARITY_OUT" | head -20
    FAILED=1
fi

# 8. Repo-Hygiene — interne Arbeitsdocs dürfen nicht getrackt sein (nur die Whitelist
#    LEGAL/STATE/ROADMAP/REQUIREMENTS/PROJECT + sensitivity-review). Verhindert, dass
#    HANDOFF.md oder .planning/-Phasenplans (mit lokalen Pfaden/Notizen) ins Public-Repo geraten.
echo -n "Repo-Hygiene... "
BAD_TRACKED=$(git ls-files 'HANDOFF.md' '.planning/*' 2>/dev/null \
    | grep -vE '^\.planning/(LEGAL|STATE|ROADMAP|REQUIREMENTS|PROJECT)\.md$|^\.planning/sensitivity-review/')
if [ -n "$BAD_TRACKED" ]; then
    echo -e "${RED}FAIL — interne Arbeitsdocs getrackt (gehören nicht ins Public-Repo):${NC}"
    echo "$BAD_TRACKED" | head -10
    echo -e "${YELLOW}  → 'git rm --cached <datei>' (bleibt lokal). Whitelist: LEGAL/STATE/ROADMAP/REQUIREMENTS/PROJECT + sensitivity-review/${NC}"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# Ergebnis
echo ""
if [ $FAILED -ne 0 ]; then
    echo -e "${RED}=== PUSH BLOCKIERT — Fehler oben beheben ===${NC}"
    exit 1
elif [ $SKIPPED -ne 0 ]; then
    # FAIL-CLOSED: Ein uebersprungenes Gate ist kein bestandenes Gate. Vorher endete der Hook
    # hier mit Exit 0 — bei offline-relais liefen PHPStan, PHPUnit und der SQL-Check alle in SKIP
    # und der Push ging trotzdem durch, ohne dass PHP je geprueft wurde.
    echo -e "${RED}=== PUSH BLOCKIERT — $SKIPPED Gate(s) konnten nicht laufen ===${NC}"
    echo -e "${YELLOW}  Diese Gates pruefen ueber relais. Ist der Host absichtlich nicht erreichbar${NC}"
    echo -e "${YELLOW}  und du willst trotzdem pushen: ALLOW_SKIPPED_GATES=1 git push${NC}"
    if [ "${ALLOW_SKIPPED_GATES:-0}" = "1" ]; then
        echo -e "${YELLOW}  ALLOW_SKIPPED_GATES=1 gesetzt — ungeprueft durchgelassen.${NC}"
    else
        exit 1
    fi
else
    echo -e "${GREEN}=== Alle Gates bestanden ===${NC}"
fi
