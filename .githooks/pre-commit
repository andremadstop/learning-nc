#!/bin/bash
# Pre-commit hook: full Gate 1 on exactly what is being committed (the git index).
#
# Gate 1 (plan 2026-09-25, Global Constraints): ESLint 0 errors, Vitest, the i18n gates,
# PHPStan L5 + PHPUnit. Everything runs on a snapshot of the index — never the working
# copy — and PHP runs in a throwaway container on this machine (scripts/gate-container.sh).
# No relais, no devcloud, no SKIP: a gate that cannot run blocks the commit.
#
# There is deliberately no "only if PHP changed" shortcut: a filter on the staged file list
# missed deletions, renames, tests, composer and phpstan config, and swallowed git errors.
#
# History, so nobody reintroduces it: until 2026-09-25 this hook ssh'ed to relais, analysed
# a copy of the working tree there and let the commit through with "nicht erreichbar"
# whenever the host was down. devcloud no longer exists, so that branch was always taken.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=lib-snapshot.sh
. "$REPO_ROOT/.githooks/lib-snapshot.sh"

SNAP="$(mktemp -d "${TMPDIR:-/tmp}/learning-precommit.XXXXXX")"
trap 'rm -r -- "$SNAP"' EXIT

echo -e "${GATE_YELLOW}=== Pre-commit: Gate 1 on the index snapshot ===${GATE_NC}"
if ! make_snapshot "$SNAP/tree" --index; then
	gate_fail "could not build the index snapshot — commit aborted"
	exit 1
fi

FAILED=0
gate_eslint "$SNAP/tree" || FAILED=1
gate_vitest "$SNAP/tree" || FAILED=1
gate_i18n   "$SNAP/tree" || FAILED=1
gate_php "$SNAP/tree" --index || FAILED=1

if [ "$FAILED" -ne 0 ]; then
	echo -e "${GATE_RED}✗ Gate 1 failed — commit aborted${GATE_NC}"
	exit 1
fi
echo -e "${GATE_GREEN}=== Pre-commit passed ===${GATE_NC}"
